# REST API base URL (no trailing slash)
#
# Local development (recommended): Vite proxies /api → Tomcat WAR path
VITE_API_BASE_URL=/api
#
# Direct Tomcat URL — only use if the backend sends CORS headers, or for non-browser tools
# VITE_API_BASE_URL=http://localhost:8080/software-engineering-project
#
# Comma-separated emails that can access the admin section (optional)
# VITE_ADMIN_EMAILS=admin@example.com
